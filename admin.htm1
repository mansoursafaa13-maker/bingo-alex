<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة تحكم البنغو - الإدارة</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #0f172a; color: #f8fafc; text-align: center; padding: 15px; margin: 0; }
        .wrapper { max-width: 450px; margin: auto; background: #1e293b; padding: 20px; border-radius: 20px; box-shadow: 0px 10px 25px rgba(0,0,0,0.5); }
        h1 { color: #38bdf8; font-size: 1.5rem; margin-bottom: 5px; }
        p { color: #94a3b8; font-size: 0.9rem; margin-top: 0; }
        .live-screen { background: #020617; border: 3px solid #38bdf8; border-radius: 15px; padding: 20px; margin: 20px 0; }
        .ball-display { font-size: 4rem; font-weight: bold; color: #f43f5e; text-shadow: 0 0 15px rgba(244,63,94,0.6); margin: 10px 0; }
        .form-group { background: #334155; padding: 15px; border-radius: 12px; margin-bottom: 15px; text-align: right; }
        .form-group h3 { margin-top: 0; color: #38bdf8; font-size: 1.1rem; }
        label { display: block; font-size: 0.85rem; color: #cbd5e1; margin-bottom: 5px; }
        input { width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #475569; background: #1e293b; color: white; box-sizing: border-box; margin-bottom: 10px; font-size: 1rem; }
        .btn { width: 100%; border: none; padding: 12px; font-size: 1.1rem; font-weight: bold; border-radius: 8px; cursor: pointer; transition: 0.2s; }
        .btn-draw { background: #38bdf8; color: #0f172a; font-size: 1.3rem; margin-bottom: 10px; }
        .btn-action { background: #22c55e; color: white; }
        .history { font-size: 0.9rem; color: #94a3b8; background: #0f172a; padding: 10px; border-radius: 8px; max-height: 60px; overflow-y: auto; }
    </style>
</head>
<body>
<div class="wrapper">
    <h1>لوحة السحب المركزي 🔴</h1>
    <p>شاشة التحكم الخاصة بك (التي تبثها عبر تطبيق PRISM)</p>
    <div class="live-screen">
        <label>الكرة الحالية</label>
        <div class="ball-display" id="currentBall">START</div>
        <button class="btn btn-draw" onclick="drawBall()">اضغط للسحب 🎲</button>
        <div class="history" id="ballHistory">الكرات السابقة: لا يوجد بعد</div>
    </div>
    <div class="form-group">
        <h3>👤 تسجيل لاعب جديد</h3>
        <label>اسم اللاعب (أو رقم الحساب)</label>
        <input type="text" id="newUsername" placeholder="مثال: أحمد العراقي">
        <button class="btn btn-action" onclick="addPlayer()">إنشاء الحساب</button>
    </div>
    <div class="form-group">
        <h3>💰 شحن رصيد</h3>
        <label>اسم اللاعب المشحون له</label>
        <input type="text" id="chargeUsername" placeholder="ادخل الاسم بدقة">
        <label>المبلغ (بالدينار أو النقاط)</label>
        <input type="number" id="chargeAmount" placeholder="مثال: 5000">
        <button class="btn btn-action" style="background:#eab308;" onclick="chargePlayer()">تأكيد الشحن</button>
    </div>
</div>
<script>
    let totalBalls = Array.from({length: 75}, (_, i) => i + 1);
    let drawnList = [];
    function drawBall() {
        if (totalBalls.length === 0) { alert("انتهت جميع الكرات الـ 75!"); return; }
        let randomIndex = Math.floor(Math.random() * totalBalls.length);
        let ball = totalBalls.splice(randomIndex, 1)[0];
        let letter = ball <= 15 ? 'B' : ball <= 30 ? 'I' : ball <= 45 ? 'N' : ball <= 60 ? 'G' : 'O';
        let fullBall = letter + "-" + ball;
        drawnList.push(fullBall);
        document.getElementById("currentBall").innerText = fullBall;
        document.getElementById("ballHistory").innerText = "الكرات السابقة: " + drawnList.join(", ");
    }
    function addPlayer() {
        let name = document.getElementById("newUsername").value;
        if(name) { alert("تم تسجيل اللاعب (" + name + ") بنجاح!"); document.getElementById("newUsername").value = ""; }
    }
    function chargePlayer() {
        let name = document.getElementById("chargeUsername").value;
        let amount = document.getElementById("chargeAmount").value;
        if(name && amount) { alert("تم شحن " + amount + " بنجاح إلى حساب: " + name); document.getElementById("chargeUsername").value = ""; document.getElementById("chargeAmount").value = ""; }
    }
</script>
</body>
</html>
